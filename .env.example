# SentinelVision AI Environment Configuration

# Core Security
SECRET_KEY=sentinelvision-super-secure-jwt-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite default, or PostgreSQL)
DATABASE_URL=sqlite:///./sentinelvision.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sentinelvision

# AI Model Paths
FIRE_MODEL_PATH=weights/best.pt
YOLO_MODEL_PATH=yolov8n.pt

# Confidence Thresholds (0.0 to 1.0)
CONFIDENCE_PERSON=0.50
CONFIDENCE_VEHICLE=0.50
CONFIDENCE_FIRE=0.75
CONFIDENCE_SMOKE=0.70
CONFIDENCE_WEAPON=0.75
CONFIDENCE_FIGHT=0.75
CONFIDENCE_FALL=0.70

# Temporal Persistence Requirements (Consecutive frames)
FIRE_PERSISTENCE_FRAMES=3
SMOKE_PERSISTENCE_FRAMES=3
FIGHT_PERSISTENCE_FRAMES=2
FALL_PERSISTENCE_FRAMES=3
INTRUSION_PERSISTENCE_FRAMES=2

# Frontend Environment
VITE_API_URL=http://localhost:8000
